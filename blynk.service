[Unit]
Description=Blynk Server
After=network.target
# Ensure the service restarts if it crashes before the network is ready
Wants=network-online.target
After=network-online.target

[Service]
User=ptut
WorkingDirectory=/opt/blynk

# ── JVM flags ──────────────────────────────────────────────────────────────────
#
# -server
#   Force server-mode JIT even on Pi (some JDKs default to client mode on ARM).
#
# -Xms32m / -Xmx256m
#   Start small; cap at 256 MB. Blynk's community server idles well under 200 MB.
#   Raise -Xmx if you get OutOfMemoryError or excessive GC pauses.
#
# -XX:+UseG1GC
#   G1 is the best fit for a long-lived, low-heap server process on Pi.
#   ZGC/Shenandoah are better for large heaps but cost more CPU on ARM.
#
# -XX:MaxGCPauseMillis=200
#   G1 targets pause times ≤ 200 ms. Keeps the server responsive on slow SD I/O.
#
# -XX:G1HeapRegionSize=4m
#   With a 256 MB heap, 4 MB regions give 64 regions – the recommended 2048-region
#   target means we stay in the "small heap" fast path.
#
# -XX:+G1UseAdaptiveIHOP
#   Let G1 auto-tune the initiating heap occupancy percentage instead of a fixed 45%.
#   Reduces unnecessary mixed GC cycles on memory-constrained hardware.
#
# -XX:+ParallelRefProcEnabled
#   Process reference objects in parallel during GC – measurable win on a quad-core Pi.
#
# -XX:+ExplicitGCInvokesConcurrent
#   If anything calls System.gc(), honour it concurrently rather than doing a
#   stop-the-world Full GC.
#
# -XX:+DisableExplicitGC
#   Alternatively: ignore System.gc() calls entirely (comment out the line above if
#   you use this one – they are mutually exclusive).
#
# -XX:+UseStringDeduplication
#   G1-only flag: de-duplicate identical String objects on the heap. Blynk stores
#   many repeated auth tokens / widget names – typically saves 5–15 % heap.
#
# -XX:+OptimizeStringConcat
#   Optimize string concatenation operations in the JIT.
#
# -Xss256k
#   Reduce per-thread stack from the default 512k/1M. Blynk's Netty threads do not
#   use deep recursion; 256 KB is ample and saves ~1 MB per dozen threads.
#
# -XX:+UseCompressedOops / -XX:+UseCompressedClassPointers
#   Already on by default below 32 GB heap, but explicit is safer across JDK builds.
#
# -Djava.security.egd=file:/dev/urandom
#   Use non-blocking entropy source. Prevents SSL handshake stalls on a Pi that has
#   little entropy (especially on first boot or minimal headless installs).
#
# --add-opens
#   Required by Blynk 0.41.x on Java 9+ for internal reflection.
# ──────────────────────────────────────────────────────────────────────────────

ExecStart=/usr/bin/java \
    -server \
    -Xms32m \
    -Xmx256m \
    -Xss256k \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -XX:G1HeapRegionSize=4m \
    -XX:+G1UseAdaptiveIHOP \
    -XX:+ParallelRefProcEnabled \
    -XX:+UseStringDeduplication \
    -XX:+OptimizeStringConcat \
    -XX:+ExplicitGCInvokesConcurrent \
    -XX:+UseCompressedOops \
    -XX:+UseCompressedClassPointers \
    -Djava.security.egd=file:/dev/urandom \
    --add-opens java.base/java.lang=ALL-UNNAMED \
    -jar /opt/blynk/server-0.41.18-java21.jar \
    -dataFolder /opt/blynk

# ── Restart policy ─────────────────────────────────────────────────────────────
Restart=always
RestartSec=10
# Don't hammer the system if the JVM hard-crashes repeatedly
StartLimitIntervalSec=120
StartLimitBurst=5

# ── Logging ────────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blynk

# ── systemd resource limits ────────────────────────────────────────────────────
#
# MemoryMax: hard ceiling; the OOM killer fires if the process exceeds this.
#   Set ~100 MB above -Xmx to give the JVM room for native/metaspace overhead.
MemoryMax=384M
#
# MemoryHigh: soft ceiling; systemd starts reclaiming before MemoryMax is hit,
#   giving the JVM a chance to GC instead of being killed.
MemoryHigh=320M
#
# MemorySwapMax=0: disable swap for this unit – swapping a JVM heap on an SD
#   card is catastrophic for latency and card longevity.
MemorySwapMax=0
#
# TasksMax: Netty uses ~handful of threads; 128 is generous and prevents runaway
#   thread creation from exhausting the system-wide PID limit.
TasksMax=128
#
# CPUWeight: normal priority (default 100). Raise to 200 if Blynk latency matters
#   more than other services; lower to 50 to de-prioritise it.
CPUWeight=100
#
# Nice: slight niceness so kernel threads and system services stay responsive.
Nice=5

# ── Hardening (optional – remove any line that breaks your setup) ──────────────
# Prevent the process from gaining new privileges via setuid/setgid binaries.
NoNewPrivileges=true
# Mount /usr, /boot, /etc read-only from the service's perspective.
ProtectSystem=strict
# Make home directories invisible to the service.
ProtectHome=true
# Allow writes only to the data and working directory.
ReadWritePaths=/opt/blynk
# Private /tmp – avoids temp file collisions with other services.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
